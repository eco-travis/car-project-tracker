# Copy to .env.local. Values for local dev come from `npm run db:start` output.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ALLOWED_EMAIL=
# Optional, local dev only: skip the magic link under `npm run dev`. Ignored by production builds.
# Set a random password, then run `npm run db:dev-password`.
DEV_AUTO_LOGIN=
DEV_LOGIN_PASSWORD=
# Per-file upload cap in MB. Match the Storage bucket's limit (human setup step 6). Default 500.
NEXT_PUBLIC_MAX_UPLOAD_MB=
